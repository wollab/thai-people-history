---
import { Menu, Search, X } from "lucide-astro";
import "../styles/global.css";
import { events, microhistories } from "../data/history";
import { synthesisStories } from "../data/syntheses";
import { formatBeCe } from "../utils/thai-year";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ประวัติศาสตร์ประชาชนไทย 2460-2560",
  description = "คลังประวัติศาสตร์ภาคประชาชนไทยผ่านชีวิต โอกาส ความคิด และการเปลี่ยนแปลง",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const eventSearchData = [
  ...events.map((event) => ({
    title: event.title,
    meta: `${formatBeCe(event.beYear, event.ceYear)} · ${event.period}`,
    href: `${base}archive/?q=${encodeURIComponent(event.title)}`,
    keywords: [event.summary, event.peopleImpact, ...event.themes, ...event.locations].join(" "),
  })),
  ...microhistories.map((record) => ({
    title: record.title,
    meta: `Microhistory · ${formatBeCe(record.beYear, record.ceYear)} · ${record.period}`,
    href: `${base}archive/?q=${encodeURIComponent(record.title)}`,
    keywords: [record.fact, record.livedExperience, ...record.everydayDimensions, ...record.groups, ...record.location].join(" "),
  })),
  ...synthesisStories.map((story) => ({
    title: story.title,
    meta: `บทสังเคราะห์ · พ.ศ. ${story.periodRange}`,
    href: `${base}reading/${story.slug}/`,
    keywords: [story.deck, story.claim, story.limits].join(" "),
  })),
];
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Thai:wght@500;600;700;800&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" data-header>
      <a class="masthead" href={base}>ประวัติศาสตร์ประชาชนไทย</a>
      <span class="date-stamp">พ.ศ. 2460-2560</span>
      <nav class="desktop-nav" aria-label="เมนูหลัก">
        <a href={`${base}archive/`}>ฐานข้อมูล</a>
        <a href={`${base}reading/`}>เส้นทางอ่าน</a>
        <a href={`${base}explore/`}>สำรวจข้อมูล</a>
        <a href={`${base}sources/`}>แหล่งอ้างอิง</a>
        <a href={`${base}gaps/`}>ร่วมค้นหา</a>
        <a href={`${base}#timeline`}>สำรวจตามเวลา</a>
        <a href={`${base}#world`}>ไทยกับโลก</a>
      </nav>
      <div class="header-actions">
        <button class="icon-button" type="button" aria-label="ค้นหา" data-search-open><Search size={21} /></button>
        <button class="icon-button mobile-menu-button" type="button" aria-label="เปิดเมนู" aria-expanded="false" data-menu-button><Menu size={23} /></button>
      </div>
      <nav class="mobile-nav" aria-label="เมนูมือถือ" data-mobile-nav hidden>
        <a href={`${base}archive/`}>ฐานข้อมูลเหตุการณ์</a>
        <a href={`${base}reading/`}>เส้นทางอ่าน</a>
        <a href={`${base}explore/`}>สำรวจแนวโน้ม</a>
        <a href={`${base}sources/`}>แหล่งอ้างอิง</a>
        <a href={`${base}gaps/`}>เรื่องที่ชวนร่วมค้นหา</a>
        <a href={`${base}#timeline`}>สำรวจตามเวลา</a>
        <a href={`${base}#world`}>ไทยกับโลก</a>
        <a href={`${base}method/`}>วิธีอ่านหลักฐาน</a>
        <a href={`${base}contribute/`}>เสนอข้อมูลหรือแก้ไข</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div>
        <strong>ประวัติศาสตร์ประชาชนไทย 2460-2560</strong>
        <p>คลังความรู้สาธารณะที่เชื่อมเหตุการณ์ ชีวิตผู้คน และแหล่งอ้างอิงตลอดหนึ่งศตวรรษ</p>
      </div>
      <nav aria-label="เมนูท้ายหน้า">
        <a href={`${base}archive/`}>ฐานข้อมูล</a>
        <a href={`${base}reading/`}>เส้นทางอ่าน</a>
        <a href={`${base}explore/`}>สำรวจข้อมูล</a>
        <a href={`${base}sources/`}>แหล่งอ้างอิง</a>
        <a href={`${base}gaps/`}>ร่วมค้นหา</a>
        <a href={`${base}method/`}>วิธีวิจัย</a>
        <a href={`${base}contribute/`}>เสนอแก้ไข</a>
      </nav>
    </footer>

    <dialog class="search-dialog" data-search-dialog>
      <form method="dialog" class="search-shell">
        <div class="search-bar">
          <Search size={22} aria-hidden="true" />
          <label class="sr-only" for="site-search">ค้นหาภายในเว็บไซต์</label>
          <input id="site-search" type="search" placeholder="ค้นหาช่วงเวลา ประเด็น หรือชีวิตผู้คน" autocomplete="off" data-search-input />
          <button class="icon-button" value="cancel" aria-label="ปิดการค้นหา"><X size={22} /></button>
        </div>
        <p class="search-hint">ค้นหาได้จาก {events.length} เหตุการณ์และ {microhistories.length} microhistory เช่น การศึกษา, แรงงาน, วิกฤต 2540</p>
        <div class="search-results" data-search-results></div>
      </form>
    </dialog>

    <script type="application/json" id="event-search-data" is:inline set:html={JSON.stringify(eventSearchData)}></script>
    <script is:inline define:vars={{ base }}>
      const menuButton = document.querySelector("[data-menu-button]");
      const mobileNav = document.querySelector("[data-mobile-nav]");
      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        mobileNav.hidden = isOpen;
      });
      mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        mobileNav.hidden = true;
        menuButton?.setAttribute("aria-expanded", "false");
      }));

      const dialog = document.querySelector("[data-search-dialog]");
      const searchInput = document.querySelector("[data-search-input]");
      const results = document.querySelector("[data-search-results]");
      const eventSearchData = JSON.parse(document.querySelector("#event-search-data")?.textContent ?? "[]");
      const searchData = [
        { title: "ฐานข้อมูลเหตุการณ์ 2460-2560", meta: "เหตุการณ์และ Microhistory", href: `${base}archive/`, keywords: "ฐานข้อมูล timeline source อ้างอิง pattern" },
        { title: "แหล่งอ้างอิงทั้งหมด", meta: "Sources", href: `${base}sources/`, keywords: "แหล่งอ้างอิง source บรรณานุกรม บริบทโลก world context" },
        { title: "เส้นทางอ่านจากชีวิตผู้คน", meta: "บทสังเคราะห์", href: `${base}reading/`, keywords: "บทสังเคราะห์ เรื่องอ่าน evidence หลักฐาน" },
        { title: "สำรวจแนวโน้มผ่านหลักฐาน", meta: "Interactive data explorer", href: `${base}explore/`, keywords: "กราฟ timeline ไทย โลก กลไก หลักฐาน dashboard สำรวจข้อมูล" },
        { title: "เรื่องที่ชวนร่วมค้นหา", meta: "ข้อมูลและมุมมองเพิ่มเติม", href: `${base}gaps/`, keywords: "ร่วมค้นหา ข้อมูลประกอบ มุมมอง คำถาม" },
        { title: "หนึ่งร้อยปีในหน้าประวัติศาสตร์", meta: "สำรวจตามเวลา", href: `${base}#timeline`, keywords: "ปี เวลา ช่วง ประวัติศาสตร์" },
        { title: "วิธีอ่านหลักฐาน", meta: "เกี่ยวกับโครงการ", href: `${base}method/`, keywords: "แหล่งอ้างอิง fact interpretation dispute สงครามเย็น" },
        { title: "เสนอข้อมูลหรือแก้ไข", meta: "Contribute", href: `${base}contribute/`, keywords: "แจ้งแก้ไข เสนอแหล่ง ข้อผิดพลาด contribution" },
        ...eventSearchData,
      ];
      document.querySelector("[data-search-open]")?.addEventListener("click", () => {
        dialog?.showModal();
        setTimeout(() => searchInput?.focus(), 0);
      });
      searchInput?.addEventListener("input", (event) => {
        const query = event.target.value.trim().toLowerCase();
        if (!query) { results.innerHTML = ""; return; }
        const matches = searchData.filter((item) => `${item.title} ${item.meta} ${item.keywords}`.toLowerCase().includes(query));
        results.innerHTML = matches.length
          ? matches.map((item) => `<a href="${item.href}"><strong>${item.title}</strong><span>${item.meta}</span></a>`).join("")
          : `<p class="empty-result">ไม่พบผลลัพธ์ ลองใช้คำที่กว้างขึ้น</p>`;
      });
    </script>
  </body>
</html>

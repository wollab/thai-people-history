---
import { ArrowLeft, CheckCircle2, ExternalLink } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { stories } from "../../data/periods";
import { beFromCe, ceRangeFromBeRange, formatBeCe } from "../../utils/thai-year";

export function getStaticPaths() {
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const sourceMap: Record<string, { caption: string; credit: string; source: string }> = {
  "city-and-mobility": {
    caption: `กรุงเทพฯ ${formatBeCe(beFromCe(1960), 1960)}`,
    credit: "Unknown author · Public domain in Thailand",
    source: "https://commons.wikimedia.org/wiki/File:Bangkok,_1960.jpg",
  },
  "education-and-dreams": {
    caption: `ห้องเรียนระดับประถม อำเภอนาหว้า จังหวัดนครพนม ${formatBeCe(beFromCe(2007), 2007)}`,
    credit: "Mattes · Public domain",
    source: "https://commons.wikimedia.org/wiki/File:Classroom_Grade_School_Na_Wa.JPG",
  },
  "everyday-economy": {
    caption: `เกษตรกรในนาข้าว ประเทศไทย ${formatBeCe(beFromCe(2016), 2016)}`,
    credit: "Jtorquy · CC0 1.0",
    source: "https://commons.wikimedia.org/wiki/File:Rice_Farmers_in_Thailand.jpg",
  },
};
const source = sourceMap[story.slug];
---

<BaseLayout title={`${story.title} | ประวัติศาสตร์ประชาชนไทย`} description={story.deck}>
  <article class="article-page container">
    <a class="back-link" href={`${base}#stories`}><ArrowLeft size={18} /> กลับสู่เรื่องที่ชวนอ่าน</a>
    <header class="article-header">
      <div class="article-date"><span>พ.ศ.</span><strong>{story.period}</strong><small>(ค.ศ. {ceRangeFromBeRange(story.period)})</small></div>
      <div><p class="eyebrow">คู่มือสำรวจหัวข้อ</p><h1>{story.title}</h1><p class="article-deck">{story.deck}</p></div>
    </header>
    <figure class="article-figure">
      <img src={`${base}${story.image}`} alt={story.imageAlt} />
      <figcaption><span>{source.caption}</span><span>{source.credit}</span></figcaption>
    </figure>
    <div class="article-layout">
      <aside class="article-index"><strong>ในหน้านี้</strong><a href="#question">คำถามสำคัญ</a><a href="#evidence">ข้อมูลที่ควรอ่านร่วมกัน</a><a href="#limits">ข้อควรระวัง</a></aside>
      <div class="article-body">
        <section id="question"><p class="status-line interpretation">คำถามสำคัญ</p><h2>อ่านความเปลี่ยนแปลงผ่านชีวิตผู้คน</h2><p>หัวข้อนี้ชวนมองว่าโครงสร้างทางเศรษฐกิจ สังคม และนโยบายปรากฏในงาน บ้าน โรงเรียน การเดินทาง และความคาดหวังของผู้คนอย่างไร</p><p>การเปรียบเทียบคนต่างพื้นที่ ชนชั้น เพศ และวัยช่วยให้เห็นว่าการเปลี่ยนแปลงเดียวกันอาจสร้างโอกาสและภาระไม่เท่ากัน</p></section>
        <section id="evidence"><p class="status-line evidence"><CheckCircle2 size={17} /> ข้อมูลที่ควรอ่านร่วมกัน</p><h2>อ่านแหล่งหลายประเภทควบคู่กัน</h2><ul><li>เอกสารรัฐและสถิติที่ระบุปี หน่วย และขอบเขตชัดเจน</li><li>หนังสือพิมพ์ ภาพถ่าย และสื่อร่วมสมัยที่บอกบรรยากาศของช่วงเวลา</li><li>งานวิชาการที่ช่วยอธิบายโครงสร้างและข้อถกเถียง</li><li>คำบอกเล่าและความทรงจำที่ทำให้เห็นประสบการณ์เฉพาะบุคคล</li></ul></section>
        <section id="limits"><p class="status-line caution">ข้อควรระวัง</p><h2>ไม่ใช้กรณีเดียวแทนคนทุกกลุ่ม</h2><p>ภาพถ่ายและเรื่องเล่าแต่ละชิ้นมีพื้นที่ เวลา และมุมมองของผู้สร้าง การอ่านร่วมกับแหล่งประเภทอื่นช่วยลดการเหมารวมและทำให้เห็นความแตกต่างภายในสังคม</p></section>
        <section class="source-note"><p class="eyebrow">ที่มาของภาพ</p><h2>ภาพประกอบหน้านี้</h2><p>{source.caption} · {source.credit}</p><a href={source.source} target="_blank" rel="noreferrer">เปิดหน้าต้นฉบับที่ Wikimedia Commons <ExternalLink size={16} /></a></section>
      </div>
    </div>
  </article>
</BaseLayout>

---
import { ArrowRight, MessageSquareText } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { microhistories } from "../../data/history";
import { periods } from "../../data/periods";

const base = import.meta.env.BASE_URL;
const documented = microhistories.filter((record) => record.evidenceStatus === "documented-case");
const leads = microhistories.filter((record) => record.evidenceStatus !== "documented-case");
---

<BaseLayout title="เรื่องที่ชวนร่วมค้นหา | ประวัติศาสตร์ประชาชนไทย" description="หัวข้อ คำถาม และมุมมองที่ผู้อ่านสามารถช่วยเสนอแหล่งข้อมูลให้คลังประวัติศาสตร์ประชาชนไทย">
  <header class="archive-header container gap-header">
    <div>
      <p class="eyebrow">ร่วมเติมประวัติศาสตร์ประชาชน</p>
      <h1>เรื่องที่ชวน<br />ร่วมค้นหา</h1>
      <p>คำถามและมุมมองต่อไปนี้ช่วยชี้ทางไปยังเอกสาร ภาพถ่าย สถิติ และคำบอกเล่าที่อาจทำให้เราเข้าใจชีวิตของผู้คนในแต่ละช่วงได้รอบด้านขึ้น</p>
    </div>
    <dl class="archive-stats">
      <div><dt>มีหลักฐานชีวิต</dt><dd>{documented.length}</dd></div>
      <div><dt>ข้อมูลประกอบ</dt><dd>{leads.length}</dd></div>
      <div><dt>ช่วงเวลา</dt><dd>{periods.length}</dd></div>
      <div><dt>คำถามชวนค้น</dt><dd>{leads.length}</dd></div>
    </dl>
  </header>

  <section class="gap-periods container" aria-label="เรื่องที่ชวนร่วมค้นหาตามช่วงเวลา">
    {periods.map((period) => {
      const periodLeads = leads.filter((record) => record.period === period.range);
      return (
        <section class="gap-period">
          <header><div><p class="eyebrow">พ.ศ. {period.range}</p><h2>{period.title}</h2></div><strong>{periodLeads.length} เรื่อง</strong></header>
          <div class="gap-list">
            {periodLeads.map((record) => (
              <article class="gap-row">
                <div><span class="evidence-badge contextual-lead">ข้อมูลประกอบ</span><h3>{record.title}</h3><p>{record.openQuestion}</p></div>
                <div class="gap-voices"><strong>มุมมองที่ชวนค้นเพิ่ม</strong><span>{record.missingVoices.join(", ")}</span></div>
                <a href={`${base}archive/?q=${encodeURIComponent(record.title)}`} aria-label={`ดูรายละเอียด ${record.title}`}><ArrowRight size={19} /></a>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </section>

  <section class="contribution-band">
    <div class="container contribution-band-inner">
      <MessageSquareText size={30} />
      <div><p class="eyebrow">ร่วมแบ่งปันแหล่งข้อมูล</p><h2>คุณมีข้อมูลเกี่ยวกับเรื่องเหล่านี้หรือไม่</h2><p>เสนอชื่อหนังสือ เลขหน้า ภาพเอกสาร คลังท้องถิ่น หรือคำอธิบายสิ่งที่ควรแก้ได้ แม้มุมมองของคุณจะแตกต่างจากบทสังเคราะห์บนเว็บไซต์</p></div>
      <a class="primary-action" href={`${base}contribute/`}>เสนอข้อมูลหรือแก้ไข <ArrowRight size={18} /></a>
    </div>
  </section>
</BaseLayout>

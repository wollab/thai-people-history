  "regional-order": "ระเบียบภูมิภาค", rent: "ค่าเช่า", resistance: "การต่อต้าน", rights: "สิทธิ", risk: "ความเสี่ยง", roads: "ถนน",
  "rural-society": "สังคมชนบท", security: "ความมั่นคง", services: "บริการ", "small-business": "ธุรกิจขนาดเล็ก",
  "social-mobility": "การเลื่อนสถานะทางสังคม", state: "รัฐ", "supply-chain": "ห่วงโซ่อุปทาน", tourism: "ท่องเที่ยว",
  trade: "การค้า", violence: "ความรุนแรง", wage: "ค่าจ้าง", wages: "ค่าจ้าง", war: "สงคราม", welfare: "สวัสดิการ",
  work: "งาน", "work-hours": "ชั่วโมงทำงาน", youth: "เยาวชน",
  accessibility: "การเข้าถึง", accountability: "ความรับผิดรับชอบ", assembly: "การชุมนุม", association: "การรวมกลุ่ม",
  bargaining: "การต่อรอง", belief: "ความเชื่อ", birth: "การเกิด", border: "ชายแดน", budget: "งบประมาณ", campaign: "การรณรงค์",
  "cash-income": "รายได้เงินสด", children: "เด็ก", city: "เมือง", "civil-society": "ภาคประชาสังคม", coast: "ชายฝั่ง",
  "coastal-resources": "ทรัพยากรชายฝั่ง", coercion: "การบังคับ", "collective-action": "การลงมือร่วมกัน", community: "ชุมชน",
  "community-action": "ปฏิบัติการชุมชน", "community-organization": "องค์กรชุมชน", "community-rights": "สิทธิชุมชน",
  "community-work": "งานชุมชน", complaint: "การร้องเรียน", cost: "ต้นทุน", curriculum: "หลักสูตร", death: "การเสียชีวิต",
  detention: "การควบคุมตัว", disability: "ความพิการ", discipline: "วินัย", discrimination: "การเลือกปฏิบัติ",
  displacement: "การพลัดถิ่น", dispute: "ข้อพิพาท", documents: "เอกสาร", electricity: "ไฟฟ้า", employment: "การจ้างงาน",
  energy: "พลังงาน", evidence: "หลักฐาน", export: "การส่งออก", expression: "การแสดงออก", "factory-work": "งานโรงงาน",
  "family-life": "ชีวิตครอบครัว", fear: "ความหวาดกลัว", fishing: "การจับปลา", "food-security": "ความมั่นคงทางอาหาร",
  "forced-labour": "แรงงานบังคับ", forest: "ป่าไม้", funeral: "งานศพ", grief: "ความโศกเศร้า", "home-work": "งานที่บ้าน",
  hospital: "โรงพยาบาล", hours: "เวลาในการทำงาน", "household-adaptation": "การปรับตัวของครัวเรือน",
  "household-economy": "เศรษฐกิจครัวเรือน", "household-income": "รายได้ครัวเรือน", "household-risk": "ความเสี่ยงครัวเรือน",
  "human-rights": "สิทธิมนุษยชน", humanitarian: "มนุษยธรรม", hygiene: "สุขอนามัย", identity: "อัตลักษณ์", illness: "การเจ็บป่วย",
  industrialization: "การทำให้เป็นอุตสาหกรรม", "informal-economy": "เศรษฐกิจนอกระบบ", injury: "การบาดเจ็บ",
  international: "ระหว่างประเทศ", isolation: "การแยกตัว", knowledge: "ความรู้", layoffs: "การเลิกจ้าง", learning: "การเรียนรู้",
  leave: "การลา", "legal-process": "กระบวนการยุติธรรม", leisure: "เวลาว่าง", "local-administration": "การบริหารท้องถิ่น",
  "local-government": "รัฐบาลท้องถิ่น", "local-knowledge": "ความรู้ท้องถิ่น", loss: "การสูญเสีย", "medical-aid": "ความช่วยเหลือทางการแพทย์",
  medicine: "ยาและการรักษา", money: "เงิน", movements: "ขบวนการเคลื่อนไหว", negotiation: "การเจรจา",
  "occupational-health": "อาชีวอนามัย", parliament: "รัฐสภา", participation: "การมีส่วนร่วม", planning: "การวางแผน",
  policy: "นโยบาย", "political-participation": "การมีส่วนร่วมทางการเมือง", poverty: "ความยากจน", prevention: "การป้องกัน",
  "price-risk": "ความเสี่ยงด้านราคา", privacy: "ความเป็นส่วนตัว", procurement: "การจัดซื้อจัดจ้าง", protest: "การประท้วง",
  "public-hearing": "การรับฟังความคิดเห็น", recovery: "การฟื้นตัว", referral: "การส่งต่อ", "regional-economy": "เศรษฐกิจภูมิภาค",
  registration: "การขึ้นทะเบียน", regulation: "การกำกับดูแล", religion: "ศาสนา", representation: "การเป็นตัวแทน",
  reproduction: "การเจริญพันธุ์", resources: "ทรัพยากร", rural: "ชนบท", safety: "ความปลอดภัย", school: "โรงเรียน",
  shelter: "ที่พักพิง", speech: "เสรีภาพในการพูด", "state-policy": "นโยบายรัฐ", "state-services": "บริการภาครัฐ",
  statistics: "สถิติ", stigma: "การตีตรา", study: "การเรียน", survival: "การอยู่รอด", tax: "ภาษี", teaching: "การสอน",
  technology: "เทคโนโลยี", transport: "การขนส่ง", travel: "การเดินทาง", treatment: "การรักษา", trust: "ความไว้วางใจ",
  union: "สหภาพแรงงาน", "urban-poverty": "ความยากจนในเมือง", urbanization: "การขยายตัวของเมือง", voting: "การลงคะแนน",
  water: "น้ำ", "working-conditions": "สภาพการทำงาน", "working-hours": "ชั่วโมงทำงาน", "world-market": "ตลาดโลก",
};

const evidenceStatusLabel: Record<string, string> = {
  "documented-case": "มีหลักฐานชีวิตจริง",
  "contextual-lead": "เบาะแสบริบท",
  "research-lead": "ต้องค้นต่อ",
};

type Row = {
  kind: "event" | "microhistory";
  id: string;
  period: string;
  beYear: string;
  ceYear: string;
  title: string;
  tags: string[];
  sourceIds: string[];
  search: string;
};

const eventRows: Row[] = events.map((event) => ({
  kind: "event",
  id: event.id,
  period: event.period,
  beYear: event.beYear,
  ceYear: event.ceYear,
  title: event.title,
  tags: event.themes,
  sourceIds: event.sourceIds,
  search: [event.title, event.summary, event.peopleImpact, event.period, ...event.themes.map((t) => tagLabels[t] ?? t), ...event.locations].join(" ").toLowerCase(),
}));

const mhRows: Row[] = microhistories.map((record) => ({
  kind: "microhistory",
  id: record.id,
  period: record.period,
  beYear: record.beYear,
  ceYear: record.ceYear,
  title: record.title,
  tags: record.everydayDimensions,
  sourceIds: record.sourceIds,
  search: [record.title, record.fact, record.livedExperience, record.period, ...record.everydayDimensions.map((t) => tagLabels[t] ?? t), ...record.groups, ...record.location].join(" ").toLowerCase(),
}));

const tagsByLabel = new Map<string, string[]>();
for (const tag of new Set([...eventRows, ...mhRows].flatMap((row) => row.tags))) {
  const label = tagLabels[tag] ?? tag;
  tagsByLabel.set(label, [...(tagsByLabel.get(label) ?? []), tag]);
}
const tagOptions = [...tagsByLabel.entries()]
  .map(([label, tags]) => ({ label, value: tags.join("|") }))
  .sort((a, b) => a.label.localeCompare(b.label, "th"));
const sortedRows = [...eventRows, ...mhRows].sort((a, b) => Number(a.beYear.match(/\d{4}/)?.[0]) - Number(b.beYear.match(/\d{4}/)?.[0]));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="ฐานข้อมูลเหตุการณ์ | ประวัติศาสตร์ประชาชนไทย" description="ค้นหาและกรองเหตุการณ์และ microhistory ประวัติศาสตร์ไทย พ.ศ. 2460-2560 พร้อมแหล่งอ้างอิงและบริบทโลก">
  <header class="archive-header container">
    <div>
      <p class="eyebrow">Open research database</p>
      <h1>ฐานข้อมูลเหตุการณ์<br />พ.ศ. 2460-2560</h1>
      <p>เหตุการณ์โครงสร้างและ microhistory ระดับชีวิตประชาชน สำหรับอ่านประวัติศาสตร์ผ่านชีวิตและโอกาสของผู้คน แต่ละรายการเปิดเผยแหล่งอ้างอิง บริบทโลก และคำถามที่ยังต้องค้นต่อ</p>
    </div>
    <dl class="archive-stats">
      <div><dt>เหตุการณ์</dt><dd>{events.length}</dd></div>
      <div><dt>Microhistory</dt><dd>{microhistories.length}</dd></div>
      <div><dt>แหล่งอ้างอิง</dt><dd>{sourceById.size}</dd></div>
      <div><dt>Pattern</dt><dd>{patterns.length}</dd></div>
    </dl>
  </header>

  <section class="archive-tools" aria-label="เครื่องมือค้นหา">
    <div class="container filter-bar">
      <label class="archive-search"><Search size={19} /><span class="sr-only">ค้นหาเหตุการณ์</span><input type="search" placeholder="ค้นหาเหตุการณ์ บุคคล หรือประเด็น" data-event-search /></label>
      <label><span>ประเภท</span><select data-type-filter><option value="">ทุกประเภท</option><option value="event">เหตุการณ์โครงสร้าง</option><option value="microhistory">Microhistory</option></select></label>
      <label><span>ช่วงเวลา</span><select data-period-filter><option value="">ทุกช่วงเวลา</option>{periods.map((period) => <option value={period.range}>{period.range}</option>)}</select></label>
      <label><span>ประเด็น</span><select data-theme-filter><option value="">ทุกประเด็น</option>{tagOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
      <button type="button" class="filter-reset" data-filter-reset>ล้างตัวกรอง</button>
    </div>
  </section>

  <section class="archive-main container" aria-label="รายการเหตุการณ์">
    <div class="archive-result-line"><p><Database size={18} /><strong data-result-count>{sortedRows.length}</strong> ระเบียน</p><p>เรียงตามปี พ.ศ. จากเก่าไปใหม่</p></div>
    <div class="event-list" data-event-list>
      {sortedRows.map((row) => {
        const rowSources = row.sourceIds.map((id) => sourceById.get(id)).filter(Boolean);

        if (row.kind === "event") {
          const event = events.find((item) => item.id === row.id)!;
          const contexts = event.worldContextIds.map((id) => worldContextById.get(id)).filter(Boolean);
          const flagged = singleSourceSensitiveEventIds.has(event.id);
          return (
            <article class="event-entry" data-event data-type="event" data-period={event.period} data-themes={event.themes.join(" ")} data-search={row.search}>
              <div class="event-date"><strong>พ.ศ. {event.beYear}</strong><span>(ค.ศ. {event.ceYear})</span></div>
              <div class="event-body">
                <div class="event-heading"><div><p class="event-period">เหตุการณ์โครงสร้าง · ช่วง {formatBeRange(event.period)}</p><h2>{event.title}</h2></div><span class:list={["evidence-badge", event.verification]}>{event.verification === "corroborated" ? "ยืนยันข้ามแหล่ง" : "ตรวจแหล่งแล้ว"}</span></div>
                <p class="event-summary">{event.summary}</p>
                {flagged && <p class="needs-sources"><AlertTriangle size={17} /><span><strong>ต้องการแหล่งเพิ่ม</strong> เหตุการณ์อ่อนไหวนี้ยังมีแหล่งอ้างอิงเพียงชุดเดียว อยู่ระหว่างหา cross-source เพิ่มก่อนเขียนบทสรุปเชิงลึก ตาม 00_research_protocol.md</span></p>}
                <section class="people-impact"><h3>ผลต่อชีวิตและโอกาสของผู้คน</h3><p>{event.peopleImpact}</p><span>{event.impactStatus === "documented" ? "มีหลักฐานผลกระทบโดยตรง" : "บริบทประกอบที่ยังต้องขยายหลักฐาน"}</span></section>
                <ul class="event-themes" aria-label="ประเด็น">{event.themes.map((tag) => <li>{tagLabels[tag] ?? tag}</li>)}</ul>
                {contexts.length > 0 && <section class="world-context"><h3><Globe2 size={18} />ไทยกับโลก</h3>{contexts.map((context) => <p><strong>{context?.title}</strong> · {context?.summary}</p>)}</section>}
                <details class="event-evidence">
                  <summary><BookOpenCheck size={18} />แหล่งอ้างอิง {rowSources.length} รายการ</summary>
                  <ol>{rowSources.map((source) => <li><a href={source?.url} target="_blank" rel="noreferrer"><span>{source?.title}</span><small>{source?.publisher}</small><ArrowUpRight size={15} /></a></li>)}</ol>
                </details>
                <p class="open-question"><CircleHelp size={18} /><span><strong>คำถามที่ยังเปิดอยู่</strong>{event.openQuestion}</span></p>
              </div>
            </article>
          );
        }

        const record = microhistories.find((item) => item.id === row.id)!;
        const linkedEvents = record.linkedEventIds.map((id) => eventById.get(id)).filter(Boolean);
        return (
          <article class="event-entry" data-event data-type="microhistory" data-period={record.period} data-themes={record.everydayDimensions.join(" ")} data-search={row.search}>
            <div class="event-date"><strong>พ.ศ. {record.beYear}</strong><span>(ค.ศ. {record.ceYear})</span></div>
            <div class="event-body">
              <div class="event-heading"><div><p class="event-period"><Users size={13} style="display:inline;vertical-align:-2px;" /> Microhistory · ช่วง {formatBeRange(record.period)}</p><h2>{record.title}</h2></div><span class:list={["evidence-badge", record.evidenceStatus]}>{evidenceStatusLabel[record.evidenceStatus]}</span></div>
              <p class="event-summary">{record.fact}</p>
              <section class="people-impact"><h3>ประสบการณ์ชีวิต</h3><p>{record.livedExperience}</p><span>กลุ่มคน: {record.groups.join(", ")} · พื้นที่: {record.location.join(", ")}</span></section>
              <ul class="event-themes" aria-label="มิติชีวิตประจำวัน">{record.everydayDimensions.map((tag) => <li>{tagLabels[tag] ?? tag}</li>)}</ul>
              {linkedEvents.length > 0 && (
                <section class="world-context"><h3><Database size={18} />เชื่อมกับเหตุการณ์โครงสร้าง</h3>
                  {linkedEvents.map((linked) => <p><a href={`${base}archive/?q=${encodeURIComponent(linked!.title)}`}>{linked?.title}</a></p>)}
                </section>
              )}
              {record.missingVoices.length > 0 && <p class="open-question"><AlertTriangle size={18} /><span><strong>เสียงที่ยังขาด</strong>{record.missingVoices.join(", ")}</span></p>}
              <details class="event-evidence">
                <summary><BookOpenCheck size={18} />แหล่งอ้างอิง {rowSources.length} รายการ</summary>
                <ol>{rowSources.map((source) => <li><a href={source?.url} target="_blank" rel="noreferrer"><span>{source?.title}</span><small>{source?.publisher}</small><ArrowUpRight size={15} /></a></li>)}</ol>
              </details>
              <p class="open-question"><CircleHelp size={18} /><span><strong>คำถามที่ยังเปิดอยู่</strong>{record.openQuestion}</span></p>
            </div>
          </article>
        );
      })}
    </div>
    <p class="archive-empty" data-event-empty hidden>ไม่พบระเบียนที่ตรงกับตัวกรอง ลองลดจำนวนคำค้นหรือเลือกช่วงเวลาใหม่</p>
  </section>

  <section class="pattern-board container" aria-label="รูปแบบที่พบข้ามเหตุการณ์">
    <div class="section-heading compact"><div><p class="eyebrow">Working patterns</p><h2>รูปแบบที่พบข้ามเหตุการณ์</h2></div><p class="draft-label">ข้อสังเกต ไม่ใช่บทสรุปสำเร็จรูป — อ้างกลับไปหลักฐานเสมอ</p></div>
    <div class="pattern-grid">
      {patterns.map((pattern) => (
        <article class="pattern-card">
          <h3>{pattern.title}</h3>
          <p>{pattern.statement}</p>
          <p class="pattern-counter"><strong>หลักฐานโต้แย้งที่ยังต้องหา:</strong> {pattern.counterEvidenceNeeded}</p>
          <div class="pattern-evidence">
            {pattern.evidenceIds.map((id) => {
              const record = microhistories.find((m) => m.id === id);
              return record ? <a href={`${base}archive/?q=${encodeURIComponent(record.title)}`}>{record.title}</a> : null;
            })}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    const search = document.querySelector("[data-event-search]");
    const type = document.querySelector("[data-type-filter]");
    const period = document.querySelector("[data-period-filter]");
    const theme = document.querySelector("[data-theme-filter]");
    const entries = [...document.querySelectorAll("[data-event]")];
    const count = document.querySelector("[data-result-count]");
    const empty = document.querySelector("[data-event-empty]");
    const applyFilters = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      entries.forEach((entry) => {
        const selectedThemes = theme.value ? theme.value.split("|") : [];
        const entryThemes = entry.dataset.themes.split(" ");
        const matches = (!query || entry.dataset.search.includes(query)) && (!type.value || entry.dataset.type === type.value) && (!period.value || entry.dataset.period === period.value) && (!selectedThemes.length || selectedThemes.some((value) => entryThemes.includes(value)));
        entry.hidden = !matches;
        if (matches) visible += 1;
      });
      count.textContent = visible;
      empty.hidden = visible !== 0;
    };
    const params = new URLSearchParams(window.location.search);
    search.value = params.get("q") ?? "";
    type.value = params.get("type") ?? "";
    period.value = params.get("period") ?? "";
    theme.value = params.get("theme") ?? "";
    [search, type, period, theme].forEach((control) => control.addEventListener(control === search ? "input" : "change", applyFilters));
    document.querySelector("[data-filter-reset]")?.addEventListener("click", () => { search.value = ""; type.value = ""; period.value = ""; theme.value = ""; applyFilters(); search.focus(); });
    applyFilters();
  </script>
</BaseLayout>

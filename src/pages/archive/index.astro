---
import { ArrowUpRight, BookOpenCheck, CircleHelp, Database, Globe2, Search } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { events, sourceById, worldContextById } from "../../data/history";
import { periods } from "../../data/periods";

const themeLabels: Record<string, string> = {
  agriculture: "เกษตรกรรม", amnesty: "นิรโทษกรรม", childhood: "เด็กและครอบครัว", citizenship: "พลเมือง",
  "cold-war": "สงครามเย็น", constitution: "รัฐธรรมนูญ", coup: "รัฐประหาร",
  culture: "วัฒนธรรม", debt: "หนี้", democracy: "ประชาธิปไตย", development: "การพัฒนา",
  decentralisation: "การกระจายอำนาจ", digital: "ดิจิทัล", disaster: "ภัยพิบัติ", economy: "เศรษฐกิจ", education: "การศึกษา",
  election: "การเลือกตั้ง", environment: "สิ่งแวดล้อม", "everyday-life": "ชีวิตประจำวัน",
  finance: "การเงิน", health: "สุขภาพ", housing: "ที่อยู่อาศัย", industry: "อุตสาหกรรม",
  inequality: "ความเหลื่อมล้ำ", infrastructure: "โครงสร้างพื้นฐาน", "international-relations": "ความสัมพันธ์ระหว่างประเทศ",
  justice: "ความยุติธรรม", labour: "แรงงาน", law: "กฎหมาย", livelihood: "การทำมาหากิน", "local-economy": "เศรษฐกิจท้องถิ่น", "local-governance": "การปกครองท้องถิ่น",
  media: "สื่อ", memory: "ความทรงจำ", migration: "การย้ายถิ่น", movement: "การเคลื่อนไหว",
  nationalism: "ชาตินิยม", politics: "การเมือง", "regional-order": "ระเบียบภูมิภาค", resistance: "การต่อต้าน", rights: "สิทธิ",
  "rural-society": "สังคมชนบท", security: "ความมั่นคง", state: "รัฐ", tourism: "ท่องเที่ยว",
  "supply-chain": "ห่วงโซ่อุปทาน", trade: "การค้า", violence: "ความรุนแรง", wage: "ค่าจ้าง", war: "สงคราม", welfare: "สวัสดิการ",
  youth: "เยาวชน",
};

const allThemes = [...new Set(events.flatMap((event) => event.themes))]
  .sort((a, b) => (themeLabels[a] ?? a).localeCompare(themeLabels[b] ?? b, "th"));
const sortedEvents = [...events].sort((a, b) => Number(a.beYear.match(/\d{4}/)?.[0]) - Number(b.beYear.match(/\d{4}/)?.[0]));
---

<BaseLayout title="ฐานข้อมูลเหตุการณ์ | ประวัติศาสตร์ประชาชนไทย" description="ค้นหาและกรองเหตุการณ์ประวัติศาสตร์ไทย พ.ศ. 2460-2560 พร้อมแหล่งอ้างอิงและบริบทโลก">
  <header class="archive-header container">
    <div>
      <p class="eyebrow">Open research database</p>
      <h1>ฐานข้อมูลเหตุการณ์<br />พ.ศ. 2460-2560</h1>
      <p>เหตุการณ์ตั้งต้นสำหรับอ่านประวัติศาสตร์ผ่านชีวิตและโอกาสของผู้คน แต่ละรายการเปิดเผยแหล่งอ้างอิง บริบทโลก และคำถามที่ยังต้องค้นต่อ</p>
    </div>
    <dl class="archive-stats">
      <div><dt>เหตุการณ์</dt><dd>{events.length}</dd></div>
      <div><dt>แหล่งอ้างอิง</dt><dd>{sourceById.size}</dd></div>
      <div><dt>ช่วงเวลา</dt><dd>{periods.length}</dd></div>
    </dl>
  </header>

  <section class="archive-tools" aria-label="เครื่องมือค้นหา">
    <div class="container filter-bar">
      <label class="archive-search"><Search size={19} /><span class="sr-only">ค้นหาเหตุการณ์</span><input type="search" placeholder="ค้นหาเหตุการณ์ บุคคล หรือประเด็น" data-event-search /></label>
      <label><span>ช่วงเวลา</span><select data-period-filter><option value="">ทุกช่วงเวลา</option>{periods.map((period) => <option value={period.range}>{period.range}</option>)}</select></label>
      <label><span>ประเด็น</span><select data-theme-filter><option value="">ทุกประเด็น</option>{allThemes.map((theme) => <option value={theme}>{themeLabels[theme] ?? theme}</option>)}</select></label>
      <button type="button" class="filter-reset" data-filter-reset>ล้างตัวกรอง</button>
    </div>
  </section>

  <section class="archive-main container" aria-label="รายการเหตุการณ์">
    <div class="archive-result-line"><p><Database size={18} /><strong data-result-count>{events.length}</strong> เหตุการณ์</p><p>เรียงตามปี พ.ศ. จากเก่าไปใหม่</p></div>
    <div class="event-list" data-event-list>
      {sortedEvents.map((event) => {
        const eventSources = event.sourceIds.map((id) => sourceById.get(id)).filter(Boolean);
        const contexts = event.worldContextIds.map((id) => worldContextById.get(id)).filter(Boolean);
        const searchable = [event.title, event.summary, event.peopleImpact, event.period, ...event.themes.map((theme) => themeLabels[theme] ?? theme), ...event.locations].join(" ").toLowerCase();
        return (
          <article class="event-entry" data-event data-period={event.period} data-themes={event.themes.join(" ")} data-search={searchable}>
            <div class="event-date"><strong>พ.ศ. {event.beYear}</strong><span>ค.ศ. {event.ceYear}</span></div>
            <div class="event-body">
              <div class="event-heading"><div><p class="event-period">ช่วง {event.period}</p><h2>{event.title}</h2></div><span class:list={["evidence-badge", event.verification]}>{event.verification === "corroborated" ? "ยืนยันข้ามแหล่ง" : "ตรวจแหล่งแล้ว"}</span></div>
              <p class="event-summary">{event.summary}</p>
              <section class="people-impact"><h3>ผลต่อชีวิตและโอกาสของผู้คน</h3><p>{event.peopleImpact}</p><span>{event.impactStatus === "documented" ? "มีหลักฐานผลกระทบโดยตรง" : "บริบทประกอบที่ยังต้องขยายหลักฐาน"}</span></section>
              <ul class="event-themes" aria-label="ประเด็น">{event.themes.map((theme) => <li>{themeLabels[theme] ?? theme}</li>)}</ul>
              {contexts.length > 0 && <section class="world-context"><h3><Globe2 size={18} />ไทยกับโลก</h3>{contexts.map((context) => <p><strong>{context?.title}</strong> · {context?.summary}</p>)}</section>}
              <details class="event-evidence">
                <summary><BookOpenCheck size={18} />แหล่งอ้างอิง {eventSources.length} รายการ</summary>
                <ol>{eventSources.map((source) => <li><a href={source?.url} target="_blank" rel="noreferrer"><span>{source?.title}</span><small>{source?.publisher}</small><ArrowUpRight size={15} /></a></li>)}</ol>
              </details>
              <p class="open-question"><CircleHelp size={18} /><span><strong>คำถามที่ยังเปิดอยู่</strong>{event.openQuestion}</span></p>
            </div>
          </article>
        );
      })}
    </div>
    <p class="archive-empty" data-event-empty hidden>ไม่พบเหตุการณ์ที่ตรงกับตัวกรอง ลองลดจำนวนคำค้นหรือเลือกช่วงเวลาใหม่</p>
  </section>

  <script is:inline>
    const search = document.querySelector("[data-event-search]");
    const period = document.querySelector("[data-period-filter]");
    const theme = document.querySelector("[data-theme-filter]");
    const entries = [...document.querySelectorAll("[data-event]")];
    const count = document.querySelector("[data-result-count]");
    const empty = document.querySelector("[data-event-empty]");
    const applyFilters = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      entries.forEach((entry) => {
        const matches = (!query || entry.dataset.search.includes(query)) && (!period.value || entry.dataset.period === period.value) && (!theme.value || entry.dataset.themes.split(" ").includes(theme.value));
        entry.hidden = !matches;
        if (matches) visible += 1;
      });
      count.textContent = visible;
      empty.hidden = visible !== 0;
    };
    const params = new URLSearchParams(window.location.search);
    search.value = params.get("q") ?? "";
    period.value = params.get("period") ?? "";
    theme.value = params.get("theme") ?? "";
    [search, period, theme].forEach((control) => control.addEventListener(control === search ? "input" : "change", applyFilters));
    document.querySelector("[data-filter-reset]")?.addEventListener("click", () => { search.value = ""; period.value = ""; theme.value = ""; applyFilters(); search.focus(); });
    applyFilters();
  </script>
</BaseLayout>

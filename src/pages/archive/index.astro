---
import { AlertTriangle, ArrowUpRight, BookOpenCheck, CircleHelp, Database, Globe2, Search, Users } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { events, microhistories, sourceById, worldContextById, eventById, singleSourceSensitiveEventIds } from "../../data/history";
import { periods } from "../../data/periods";
import { patterns } from "../../data/research-index";
import { formatBeRange } from "../../utils/thai-year";

const tagLabels: Record<string, string> = {
  agriculture: "เกษตรกรรม", amnesty: "นิรโทษกรรม", "black-market": "ตลาดมืด", care: "การดูแล", "care-work": "งานดูแล",
  childhood: "เด็กและครอบครัว", citizenship: "พลเมือง", class: "ชนชั้น", clothing: "การแต่งกาย",
  "cold-war": "สงครามเย็น", commerce: "การค้าขาย", communication: "การสื่อสาร", constitution: "รัฐธรรมนูญ", coping: "การรับมือ",
  coup: "รัฐประหาร", credit: "สินเชื่อ", culture: "วัฒนธรรม", debt: "หนี้", democracy: "ประชาธิปไตย", development: "การพัฒนา",
  decentralisation: "การกระจายอำนาจ", digital: "ดิจิทัล", "digital-divide": "ช่องว่างดิจิทัล", disaster: "ภัยพิบัติ",
  economy: "เศรษฐกิจ", education: "การศึกษา", election: "การเลือกตั้ง", environment: "สิ่งแวดล้อม", ethnicity: "ชาติพันธุ์",
  "everyday-life": "ชีวิตประจำวัน", factory: "โรงงาน", family: "ครอบครัว", finance: "การเงิน", fishery: "การประมง",
  food: "อาหาร", gender: "เพศสภาพ", health: "สุขภาพ", housing: "ที่อยู่อาศัย", "household-cost": "ค่าใช้จ่ายครัวเรือน",
  income: "รายได้", industry: "อุตสาหกรรม", inequality: "ความเหลื่อมล้ำ", information: "ข้อมูลข่าวสาร",
  infrastructure: "โครงสร้างพื้นฐาน", "international-relations": "ความสัมพันธ์ระหว่างประเทศ", jobs: "งานและอาชีพ",
  justice: "ความยุติธรรม", labour: "แรงงาน", land: "ที่ดิน", language: "ภาษา", law: "กฎหมาย", "legal-status": "สถานะทางกฎหมาย",
  literacy: "การรู้หนังสือ", livelihood: "การทำมาหากิน", "local-economy": "เศรษฐกิจท้องถิ่น", "local-governance": "การปกครองท้องถิ่น",

---
import { ArrowUpRight, Globe2 } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sources, worldContexts } from "../../data/history";
import { formatBeCe } from "../../utils/thai-year";

const sourceTypeLabel: Record<string, string> = {
  "official-history": "ประวัติทางการ", "official-record": "บันทึกทางการ", "peer-reviewed-research": "งานวิจัยตรวจทาน",
  "institutional-research": "งานวิจัยสถาบัน", "primary-document": "เอกสารปฐมภูมิ", "legal-record": "บันทึกกฎหมาย",
  "institutional-report": "รายงานสถาบัน", "anthropological-research": "งานวิจัยมานุษยวิทยา", "institutional-history": "ประวัติสถาบัน",
  "scholarly-official": "งานวิชาการทางการ", research: "งานวิจัย", archive: "จดหมายเหตุ", "archival-study": "งานศึกษาจดหมายเหตุ",
  "official-plan": "แผนทางการ", "primary-document-archive": "จดหมายเหตุเอกสารปฐมภูมิ", "public-archive": "จดหมายเหตุสาธารณะ",
  "official-case-record": "บันทึกคดีทางการ", "official-commemoration": "การรำลึกทางการ", "secondary-summary-of-official-report": "สรุปรายงานทางการ",
  "institutional-assessment": "การประเมินสถาบัน", "official-statistics": "สถิติทางการ", "doctoral-research": "วิทยานิพนธ์ปริญญาเอก",
  "oral-history-research": "งานวิจัยประวัติศาสตร์บอกเล่า", "academic-thesis": "วิทยานิพนธ์", "open-access-dissertation": "ดุษฎีนิพนธ์เปิดเผย",
  "field-research": "งานวิจัยภาคสนาม", "ethnographic-case-study": "กรณีศึกษาชาติพันธุ์วรรณนา", "qualitative-case-study": "กรณีศึกษาเชิงคุณภาพ",
  "household-survey-research": "งานสำรวจครัวเรือน", "official-survey-series": "ชุดสำรวจทางการ",
};

const sortedSources = [...sources].sort((a, b) => a.title.localeCompare(b.title, "th"));
const sortedContexts = [...worldContexts].sort((a, b) => (a.beYear ?? "").localeCompare(b.beYear ?? ""));
---

<BaseLayout title="แหล่งอ้างอิงทั้งหมด | ประวัติศาสตร์ประชาชนไทย" description="บรรณานุกรมและบริบทโลกทั้งหมดที่ใช้ในฐานข้อมูลประวัติศาสตร์ประชาชนไทย พ.ศ. 2460-2560 พร้อมลิงก์เปิดต้นฉบับ">
  <header class="archive-header container">
    <div>
      <p class="eyebrow">Bibliography</p>
      <h1>แหล่งอ้างอิง<br />ทั้งหมด</h1>
      <p>บรรณานุกรมทุกรายการที่ใช้รองรับเหตุการณ์และ microhistory ในฐานข้อมูล เปิดต้นฉบับได้ทันทีเพื่อใช้ตรวจสอบหรืออ้างอิงต่อในงานของคุณเอง</p>
    </div>
    <dl class="archive-stats stats-2">
      <div><dt>แหล่งอ้างอิง</dt><dd>{sources.length}</dd></div>
      <div><dt>บริบทโลก</dt><dd>{worldContexts.length}</dd></div>
    </dl>
  </header>

  <section class="archive-main container" aria-label="รายการแหล่งอ้างอิง">
    <div class="archive-result-line"><p><strong>{sortedSources.length}</strong> แหล่งอ้างอิง</p><p>เรียงตามชื่อเรื่อง</p></div>
    <div class="source-table-wrap">
      <table class="source-table">
        <thead><tr><th>ชื่อแหล่ง</th><th>ผู้เผยแพร่</th><th>ประเภท</th><th>ภาษา</th><th>ลิงก์</th></tr></thead>
        <tbody>
          {sortedSources.map((source) => (
            <tr>
              <td>{source.title}{source.note && <span class="source-note-flag" title={source.note}> · แก้ไขแล้ว</span>}</td>
              <td>{source.publisher}</td>
              <td>{sourceTypeLabel[source.type] ?? source.type}</td>
              <td>{source.language === "th" ? "ไทย" : "อังกฤษ"}</td>
              <td><a href={source.url} target="_blank" rel="noreferrer">เปิดต้นฉบับ <ArrowUpRight size={14} /></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="archive-main container" id="world" aria-label="บริบทโลก">
    <div class="archive-result-line"><p><Globe2 size={18} /><strong>{sortedContexts.length}</strong> บริบทโลก/ภูมิภาค</p><p>เรียงตามปี พ.ศ.</p></div>
    <div class="source-table-wrap">
      <table class="source-table">
        <thead><tr><th>ปี</th><th>เหตุการณ์โลก/ภูมิภาค</th><th>ช่องทางอิทธิพล</th><th>ความเชื่อมโยงกับไทย</th></tr></thead>
        <tbody>
          {sortedContexts.map((context) => (
            <tr>
              <td>{formatBeCe(context.beYear, context.ceYear)}</td>
              <td><strong>{context.title}</strong><br /><span class="source-summary">{context.summary}</span></td>
              <td>{context.channel}</td>
              <td>{context.relation === "direct" ? "โดยตรง" : context.relation === "indirect" ? "โดยอ้อม" : "บริบทประกอบ"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

---
import { AlertTriangle, CheckCircle2, CircleHelp, Scale } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { events, microhistories, sources } from "../../data/history";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="วิธีอ่านหลักฐาน | ประวัติศาสตร์ประชาชนไทย">
  <article class="method-page container">
    <header><p class="eyebrow">วิธีอ่านและตรวจสอบข้อมูล</p><h1>อ่านหลักฐานอย่างไร<br />โดยไม่ทำให้ความจริงง่ายเกินไป</h1><p>คลังนี้แยกสิ่งที่แหล่งข้อมูลระบุออกจากการตีความ และพาผู้อ่านกลับไปตรวจต้นฉบับได้จากแต่ละเรื่อง</p></header>
    <section class="principle-grid" id="evidence">
      <article><CheckCircle2 /><h2>ข้อเท็จจริง</h2><p>ข้อความที่มีแหล่งอ้างอิงชัดเจน ระบุปี หน่วย นิยาม หรือหน้าต้นทางได้</p></article>
      <article><Scale /><h2>การตีความ</h2><p>คำอธิบายความหมายหรือความสัมพันธ์ระหว่างหลักฐาน ซึ่งควรอ่านแยกจากข้อเท็จจริงที่แหล่งระบุ</p></article>
      <article><AlertTriangle /><h2>ข้อถกเถียง</h2><p>จุดที่แหล่งข้อมูลหรือผู้ศึกษาให้คำอธิบายต่างกัน โดยแสดงแต่ละมุมมองพร้อมที่มา</p></article>
      <article><CircleHelp /><h2>ขอบเขตการอ่าน</h2><p>สิ่งที่ข้อมูลชุดนั้นอธิบายได้ รวมถึงกลุ่มคน พื้นที่ หรือช่วงเวลาที่ไม่ควรนำไปเหมารวม</p></article>
    </section>
    <section class="method-copy"><h2>หลักการของคลัง</h2><ol><li>เหตุการณ์ทุกเรื่องเชื่อมกลับไปยังแหล่งที่ตรวจสอบได้</li><li>เหตุการณ์สำคัญหรืออ่อนไหวเปรียบเทียบข้อมูลจากแหล่งต่างประเภท</li><li>ตัวเลขแสดงปี ชุดข้อมูล หน่วย และนิยาม</li><li>การเกิดขึ้นในเวลาเดียวกันไม่ถูกใช้แทนหลักฐานเชิงเหตุและผล</li><li>บทสังเคราะห์บอกขอบเขตของข้อมูลและมุมมองที่ควรอ่านเพิ่มเติม</li></ol></section>
    <section class="method-copy"><h2>ป้ายกำกับข้อมูล</h2><p><strong>ตรวจแหล่งแล้ว</strong> หมายถึงข้อเท็จจริงหลักตรวจกลับไปยังแหล่งที่ระบุได้ ส่วน <strong>ยืนยันข้ามแหล่ง</strong> หมายถึงมีแหล่งมากกว่าหนึ่งชุดสนับสนุนข้อมูลหลัก</p><p><strong>มีหลักฐานชีวิตโดยตรง</strong> ใช้เมื่อมีงานศึกษาหรือข้อมูลของประชาชนรองรับ ส่วน <strong>ข้อมูลประกอบ</strong> ใช้วางเหตุการณ์ในบริบทโดยไม่เติมประสบการณ์เฉพาะบุคคลเกินจากที่แหล่งระบุ</p></section>
    <section class="method-copy"><h2>ข้อมูลในคลัง</h2><p>ปัจจุบันมี {events.length} เหตุการณ์, {microhistories.length} กรณีชีวิตประชาชน และ {sources.length} แหล่งอ้างอิง ผู้อ่านสามารถค้นรายการทั้งหมดใน <a href={`${base}archive/`}>ฐานข้อมูล</a> และเปิดต้นฉบับจากหน้า <a href={`${base}sources/`}>แหล่งอ้างอิง</a></p><p>จำนวนแหล่งไม่ใช่คะแนนความจริง และไม่ได้หมายความว่าข้อถกเถียงสิ้นสุดลง การอ่านชนิดของแหล่ง พื้นที่ เวลา และวิธีเก็บข้อมูลยังคงสำคัญ</p></section>
    <section class="method-copy" id="rights"><h2>สิทธิภาพและสื่อ</h2><p>ภาพบนเว็บไซต์ระบุผู้สร้าง วันที่ แหล่งเก็บ และสัญญาอนุญาตเมื่อข้อมูลมีอยู่ สื่อที่ยังไม่ได้รับอนุญาตหรืออาจทำให้ผู้ให้ข้อมูลเสี่ยงจะไม่ถูกเผยแพร่</p></section>
  </article>
</BaseLayout>
